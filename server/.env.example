# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=8787

# Where levels.json is stored, relative to this file.
DATA_DIR=./data

# The players and their keys, as Name:key pairs separated by commas, e.g.
#   PUBLISH_TOKENS=Scotty:7f2k9q1x8a1z,Anaïs:m3p0v6t2r9wd
# The name is what shows on every leaderboard (whatever name is typed in the
# game), and every player listed here appears in the rankings, even at 0.
# Keys can be anything long and unguessable; each person enters only theirs
# in KINETIK's settings.
PUBLISH_TOKENS=

# Comma-separated list of origins allowed to call this server from a browser
# (your deployed KINETIK web build, e.g. https://kinetik.example.com). Use *
# only while testing locally — never in production, since reads are already
# public and an open CORS policy plus a leaked publish token is worse than
# either alone.
ALLOWED_ORIGINS=*
