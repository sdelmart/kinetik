# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=8787

# Where levels.json is stored, relative to this file.
DATA_DIR=./data

# Comma-separated list of secrets, one per person allowed to publish. Anyone
# can make these up (e.g. "scott-7f2k9", "mathieu-x8a1z") — they don't need to
# mean anything, they just need to be long and unguessable, and each person
# enters theirs once in KINETIK's settings.
PUBLISH_TOKENS=

# Comma-separated list of origins allowed to call this server from a browser
# (your deployed KINETIK web build, e.g. https://kinetik.example.com). Use *
# only while testing locally — never in production, since reads are already
# public and an open CORS policy plus a leaked publish token is worse than
# either alone.
ALLOWED_ORIGINS=*
