{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KINETIK",
  "version": "1.0.0",
  "identifier": "io.kinetik.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev -- --port 5180 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "KINETIK",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "Puzzle industriel de tri de conteneurs",
    "longDescription": "KINETIK — poussez les conteneurs sur les plaques de charge à travers cinq secteurs, avec éditeur de niveaux intégré."
  }
}
